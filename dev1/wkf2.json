    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  // Check all possible field names from Google Sheets node\n  let rawImage = item.json.image || item.json.imagePath || item.json.image_url || \"\";\n  rawImage = rawImage.trim();\n\n  // Remove file:/// or file://\n  let cleanImage = rawImage.replace(/^file:\\/\\/\\/?/i, \"\");\n\n  return {\n    json: {\n      title: item.json.title ? item.json.title.replace(/[\\r\\n]+/g, \" \").trim() : \"\",\n      imagePath: cleanImage,\n      comment: item.json.comment ? item.json.comment.trim() : \"\"\n    }\n  };\n});"
      },
