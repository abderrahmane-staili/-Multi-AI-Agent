      "parameters": {
        "jsCode": "// 1. استخراج الـ Items اللي جايين من Loop 1\nconst inputItems = $input.all();\n\n// 2. إنشاء Unique Hash لكل Batch بناءً على الوقت والـ Data\n// هادشي كيجبر loop 2 تعامل مع البيانات كأنها أول مرة تشوفها فـ Memory\nconst timestamp = Date.now();\n\nreturn inputItems.map((item, index) => {\n  return {\n    json: {\n      // تفكيك البيانات القديمة بالكامل (Deep Clone)\n      ...JSON.parse(JSON.stringify(item.json)),\n      // إشارة تتبع ديموغرافية كتجبر الـ Memory تدير Reset\n      _batchContextId: `batch_${timestamp}_${index}`\n    }\n  };\n});"
      },
